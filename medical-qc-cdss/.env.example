# ============================================================================
# QC-CDSS 配置模板：复制为 .env 后按环境修改
# ============================================================================

# ---- 基础 ----
QC_ENV=dev
QC_DEBUG=false
QC_API_PREFIX=/v1
QC_DATA_DIR=./data

# ---- 模型服务（三选一）----
# 1) 私有化 vLLM（生产）
# QC_LLM_PROVIDER=vllm
# QC_LLM_BASE_URL=http://vllm:8000/v1
# QC_LLM_MODEL=Qwen2.5-32B-Instruct-AWQ
#
# 2) 云 API（混合云/试点）
# QC_LLM_PROVIDER=cloud
# QC_LLM_BASE_URL=https://api.deepseek.com/v1
# QC_LLM_API_KEY=sk-xxxx
# QC_LLM_MODEL=deepseek-chat
#
# 3) 离线 Mock（无 GPU 演示/CI）
QC_LLM_PROVIDER=mock
QC_LLM_MODEL=mock-qwen

QC_LLM_API_KEY=EMPTY
QC_LLM_TIMEOUT_S=60
QC_LLM_MAX_RETRIES=2
QC_LLM_TEMPERATURE=0.1
QC_LLM_MAX_TOKENS=2048
# guided | json_object | prompt_only
QC_LLM_JSON_MODE=guided

# 主模型故障时降级：none | cloud | mock
QC_LLM_FALLBACK_PROVIDER=mock

# ---- 向量化 ----
# openai：调用 vLLM 部署的 bge-m3 / Qwen3-Embedding；hash：零依赖离线模式
QC_EMBEDDING_PROVIDER=hash
QC_EMBEDDING_MODEL=bge-m3
QC_EMBEDDING_DIM=256

# ---- 向量库：memory | milvus | chroma ----
QC_VECTOR_STORE=memory
QC_MILVUS_URI=http://milvus:19530
QC_MILVUS_COLLECTION=qc_knowledge
QC_CHROMA_PATH=./data/chroma
QC_RETRIEVAL_TOP_K=8
QC_RRF_K=60

# ---- 缓存 ----
QC_REDIS_URL=redis://redis:6379/0
QC_CACHE_TTL_S=21600

# ---- 数据库 ----
QC_DATABASE_URL=sqlite+aiosqlite:///./data/qc_cdss.db
# QC_DATABASE_URL=mysql+asyncmy://qc:qc_pass@mysql:3306/qc_cdss?charset=utf8mb4

# ---- 并发与超时 ----
QC_MAX_CONCURRENCY=16
QC_SHORT_REQUEST_SLOTS=6
QC_REQUEST_DEADLINE_S=45
QC_BRANCH_TIMEOUT_S=25
QC_MAX_SHARDS=4
QC_SHARD_CHARS=1200

# ---- 证据校验阈值 ----
QC_EVIDENCE_ACCEPT_THRESHOLD=88
QC_EVIDENCE_REVIEW_THRESHOLD=70

# ---- 鉴权 ----
QC_AUTH_ENABLED=false
QC_JWT_SECRET=change-me-in-production
QC_JWT_EXPIRE_MINUTES=120

# ---- 隐私 ----
QC_PII_MASKING=true

# ---- 版本 ----
QC_PROMPT_VERSION=2026.11.1
QC_CHECKLIST_VERSION=v1
