# 复制为 .env 后按本机情况修改；.env 不要提交到仓库（见 .gitignore）
# 变量名 = 代码里 Settings 字段名的大写形式，前缀 CDSS_

CDSS_ENV=dev
CDSS_HOST=127.0.0.1
CDSS_PORT=8000
CDSS_LOG_LEVEL=INFO
CDSS_DOCS_ENABLED=true

